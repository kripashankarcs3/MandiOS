# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Optional: any OpenAI-compatible provider (overrides the Groq values above).
# e.g. OpenCode Zen (free): LLM_BASE_URL=https://opencode.ai/zen/v1 and LLM_MODEL=big-pickle
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
PORT=3001
# Pause between streamed events (ms) so judges can follow the negotiation
EVENT_DELAY_MS=550
LLM_TIMEOUT_MS=15000
# Set to 1 to force the rule-based agents (no API calls)
FORCE_OFFLINE=0
# Only needed if the frontend is hosted on a different domain
CORS_ORIGIN=
